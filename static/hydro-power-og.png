<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg width="1200" height="630" viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg">
  <rect width="1200" height="630" fill="#1a73e8"/>
  <g>
    <!-- 水車のイラスト -->
    <circle cx="300" cy="315" r="150" fill="#ffffff" opacity="0.2"/>
    <circle cx="300" cy="315" r="130" fill="none" stroke="#ffffff" stroke-width="8"/>
    <circle cx="300" cy="315" r="30" fill="#ffffff"/>
    
    <!-- 水車の羽根 -->
    <path d="M300,185 L330,315 L300,315 Z" fill="#ffffff" transform="rotate(0 300 315)"/>
    <path d="M300,185 L330,315 L300,315 Z" fill="#ffffff" transform="rotate(45 300 315)"/>
    <path d="M300,185 L330,315 L300,315 Z" fill="#ffffff" transform="rotate(90 300 315)"/>
    <path d="M300,185 L330,315 L300,315 Z" fill="#ffffff" transform="rotate(135 300 315)"/>
    <path d="M300,185 L330,315 L300,315 Z" fill="#ffffff" transform="rotate(180 300 315)"/>
    <path d="M300,185 L330,315 L300,315 Z" fill="#ffffff" transform="rotate(225 300 315)"/>
    <path d="M300,185 L330,315 L300,315 Z" fill="#ffffff" transform="rotate(270 300 315)"/>
    <path d="M300,185 L330,315 L300,315 Z" fill="#ffffff" transform="rotate(315 300 315)"/>
    
    <!-- 水の波紋 -->
    <path d="M450,400 Q500,370 550,400 Q600,430 650,400 Q700,370 750,400" fill="none" stroke="#ffffff" stroke-width="6"/>
    <path d="M450,430 Q500,400 550,430 Q600,460 650,430 Q700,400 750,430" fill="none" stroke="#ffffff" stroke-width="6"/>
  </g>
  
  <!-- テキスト -->
  <text x="600" y="250" font-family="Arial, sans-serif" font-size="60" font-weight="bold" fill="#ffffff" text-anchor="middle">マイクロ・小水力発電</text>
  <text x="600" y="320" font-family="Arial, sans-serif" font-size="60" font-weight="bold" fill="#ffffff" text-anchor="middle">シミュレータ</text>
  <text x="600" y="400" font-family="Arial, sans-serif" font-size="30" fill="#ffffff" text-anchor="middle">流量・落差から発電量を計算</text>
</svg> 
