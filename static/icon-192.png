<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg width="192" height="192" viewBox="0 0 192 192" xmlns="http://www.w3.org/2000/svg">
  <rect width="192" height="192" fill="#1a73e8" rx="48" ry="48"/>
  <g>
    <!-- 水車のイラスト -->
    <circle cx="96" cy="96" r="60" fill="#ffffff" opacity="0.2"/>
    <circle cx="96" cy="96" r="50" fill="none" stroke="#ffffff" stroke-width="4"/>
    <circle cx="96" cy="96" r="12" fill="#ffffff"/>
    
    <!-- 水車の羽根 -->
    <path d="M96,46 L110,96 L96,96 Z" fill="#ffffff" transform="rotate(0 96 96)"/>
    <path d="M96,46 L110,96 L96,96 Z" fill="#ffffff" transform="rotate(45 96 96)"/>
    <path d="M96,46 L110,96 L96,96 Z" fill="#ffffff" transform="rotate(90 96 96)"/>
    <path d="M96,46 L110,96 L96,96 Z" fill="#ffffff" transform="rotate(135 96 96)"/>
    <path d="M96,46 L110,96 L96,96 Z" fill="#ffffff" transform="rotate(180 96 96)"/>
    <path d="M96,46 L110,96 L96,96 Z" fill="#ffffff" transform="rotate(225 96 96)"/>
    <path d="M96,46 L110,96 L96,96 Z" fill="#ffffff" transform="rotate(270 96 96)"/>
    <path d="M96,46 L110,96 L96,96 Z" fill="#ffffff" transform="rotate(315 96 96)"/>
    
    <!-- 水の波紋 -->
    <path d="M96,140 Q110,130 124,140" fill="none" stroke="#ffffff" stroke-width="3"/>
    <path d="M96,150 Q110,140 124,150" fill="none" stroke="#ffffff" stroke-width="3"/>
  </g>
</svg> 
